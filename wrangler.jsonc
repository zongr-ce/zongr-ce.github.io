{
  // Name of the Cloudflare project this repo deploys to.
  "name": "portfolio",

  // Pins the Workers runtime behaviour to this date so future
  // platform changes cannot silently alter your deploy.
  "compatibility_date": "2026-09-07",

  "observability": { "enabled": true },

  "assets": {
    // Serve the repo root directly; no build step needed, so the
    // default deploy commands work for production and previews alike.
    // .assetsignore keeps .git and other non-site files out of the
    // upload (the .git folder used to blow past the 25 MiB file cap).
    "directory": "."
  }
}
